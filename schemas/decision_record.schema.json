{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "REBUILD Decision Record",
  "description": "Decision record. key_assumptions accepts two forms: a plain string, or a structured object of \"assumption + falsification condition\". The latter is the form models adopt spontaneously when connected to a real model runtime — it pairs each assumption with the condition that could overturn it, which is more useful than a plain string, so it is admitted into the schema rather than suppressed.",
  "type": "object",
  "required": [
    "decision_id", "question", "options", "chosen_option", "rejected_options",
    "tradeoffs", "key_assumptions", "falsification_conditions",
    "validation_actions", "review_date"
  ],
  "properties": {
    "decision_id": {"type": "string"},
    "question": {"type": "string"},
    "deadline": {"type": ["string", "null"]},
    "options": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["name", "rationale"],
        "properties": {
          "name": {"type": "string"},
          "rationale": {"type": "string"},
          "risks": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "chosen_option": {
      "type": ["string", "null"],
      "description": "Name of the chosen option. **null is allowed** — when the gate judges the evidence insufficient and this round should gather further evidence before deciding, null is the honest and correct value, better than fabricating an option. In that case validation_actions must state what evidence must be gathered before a decision can be made."
    },
    "rejected_options": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "reason"],
        "properties": {
          "name": {"type": "string"},
          "reason": {"type": "string"}
        }
      }
    },
    "tradeoffs": {"type": "array", "items": {"type": "string"}},
    "key_assumptions": {
      "type": "array",
      "items": {
        "oneOf": [
          {"type": "string"},
          {
            "type": "object",
            "required": ["assumption"],
            "properties": {
              "assumption": {"type": "string", "minLength": 1},
              "falsification_condition": {"type": ["string", "null"]},
              "confidence": {"enum": ["HIGH", "MEDIUM", "LOW"]},
              "evidence_ids": {"type": "array", "items": {"type": "string"}},
              "note": {"type": ["string", "null"]}
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "falsification_conditions": {"type": "array", "items": {"type": "string"}},
    "validation_actions": {"type": "array", "items": {"type": "string"}},
    "review_date": {"type": "string"}
  },
  "additionalProperties": false
}
