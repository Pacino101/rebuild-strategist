# Bench run artefacts: contain unpublished model answers and salts, not committed by default.
# scorecard.csv is meant to be public and is not listed here.
bench/runs/

# Orchestrator run artefacts: contain model outputs and excerpts from project material, which may involve client information.
# When the result of a run needs to be published, explicitly git add -f the individual file.
runs/

# Project material library and evidence ledger: usually client data, not committed by default.
# If an example project needs to be committed, put a separate .gitignore exception in that directory.
sources/documents/
sources/index.jsonl
sources/specs/
evidence.jsonl
