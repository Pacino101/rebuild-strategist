{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "REBUILD Task Packet",
  "type": "object",
  "required": [
    "task_id",
    "project_id",
    "assigned_role",
    "objective",
    "context",
    "questions",
    "inputs",
    "output_contract",
    "acceptance_criteria",
    "risk_level",
    "stop_condition"
  ],
  "properties": {
    "task_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "assigned_role": {
      "type": "string"
    },
    "objective": {
      "type": "string"
    },
    "context": {
      "type": "string"
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "source_status"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "source_status": {
            "enum": [
              "provided",
              "retrieved",
              "assumption",
              "missing"
            ]
          },
          "reference": {
            "type": "string"
          }
        }
      }
    },
    "output_contract": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "priority": {
      "enum": [
        "P0",
        "P1",
        "P2",
        "P3"
      ]
    },
    "deadline": {
      "type": [
        "string",
        "null"
      ]
    },
    "risk_level": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "stop_condition": {
      "type": "string"
    },
    "side_effects_allowed": {
      "type": "boolean",
      "default": false
    }
  },
  "additionalProperties": false
}
